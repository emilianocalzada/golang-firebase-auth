# Copy to .env and fill in. .env is gitignored.

# Firebase project that issues the ID tokens the mobile app sends.
FIREBASE_PROJECT_ID=

# Path to the service account JSON. For local development.
FIREBASE_CREDENTIALS_FILE=

# The service account JSON itself, for deployments whose only secret store is
# the environment (Coolify, Fly, Railway). Set this OR the file above, not both.
#
# Use the base64 form: the raw JSON is multi-line and its private_key relies on
# \n escapes that dashboard textareas quietly mangle.
#   base64 -i your-service-account.json | pbcopy
# FIREBASE_CREDENTIALS_JSON=

# RevenueCat V2 secret API key, needs the customer_information:customers:read
# permission. V1 keys do not work against the v2 API.
REVENUECAT_SECRET_API_KEY=

# RevenueCat project id (looks like proj1ab2c3d4). The v2 API is scoped to it.
REVENUECAT_PROJECT_ID=

# The exact Authorization header value set in the RevenueCat dashboard webhook
# openssl rand -hex 32
# config. Must be at least 16 characters.
REVENUECAT_WEBHOOK_AUTH="Bearer a-long-random-secret"

# Entitlement that unlocks presentation creation.
REVENUECAT_ENTITLEMENT_ID="AppName Pro"

# Optional overrides.
PORT=8000
DATABASE_PATH=./aislide.db

# Reverse proxy trust. Leave both empty for local development: the client IP is
# then the socket peer, which is correct when nothing sits in front.
#
# Deployed behind Coolify (Traefik) with Cloudflare proxying DNS, set both. The
# CIDRs are the private Docker networks Traefik connects from, and the header is
# the only one Cloudflare guarantees holds a single, unspoofable client IP.
# Do not use X-Forwarded-For here: Cloudflare appends the client IP to whatever
# the caller already sent, so its leading entries are attacker controlled.
#
# This is only trustworthy while the origin cannot be reached except through
# Cloudflare. Restrict ports 80/443 on the VPS firewall to Cloudflare's IP
# ranges, or front it with a cloudflared tunnel, otherwise anyone who finds the
# server's IP can set CF-Connecting-IP to whatever they want.
# TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
# CLIENT_IP_HEADER=CF-Connecting-IP
