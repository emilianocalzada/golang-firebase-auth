# Copy to .env and fill in. .env is gitignored.

# Firebase project that issues the ID tokens the mobile app sends.
FIREBASE_PROJECT_ID=

# Path to the service account JSON. Leave empty on a cloud host to use
# Application Default Credentials instead.
FIREBASE_CREDENTIALS_FILE=

# RevenueCat V2 secret API key, needs the customer_information:customers:read
# permission. V1 keys do not work against the v2 API.
REVENUECAT_SECRET_API_KEY=

# RevenueCat project id (looks like proj1ab2c3d4). The v2 API is scoped to it.
REVENUECAT_PROJECT_ID=

# The exact Authorization header value set in the RevenueCat dashboard webhook
# openssl rand -hex 32
# config. Must be at least 16 characters.
REVENUECAT_WEBHOOK_AUTH="Bearer a-long-random-secret"

# Entitlement that unlocks presentation creation.
REVENUECAT_ENTITLEMENT_ID="AppName Pro"

# Optional overrides.
PORT=8000
DATABASE_PATH=./aislide.db
